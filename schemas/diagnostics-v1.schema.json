        },
        "tag": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "class": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "childCount": {
          "type": "integer",
