{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dol-dev-tools:source-find-query:v1",
  "title": "Read-only source-find CLI query (root and revision are explicit CLI options)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "clues"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "clues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "passage",
              "widget",
              "text",
              "selector",
              "event",
              "symbol",
              "path"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "allOf": [
              {
                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
              },
              {
                "pattern": "[^\\u0009-\\u000d\\u0020\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
              }
            ]
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxResults": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 33554432
        },
        "contextLines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        }
      }
    }
  }
}
